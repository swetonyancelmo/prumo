# ==========================================================================
# Prumo — variáveis de ambiente da API (EXEMPLO). Copie para .env e preencha.
# NUNCA commite o .env real.
# ==========================================================================

# --- App ---
PORT=3000
NODE_ENV=development

# Relatórios agregam em horário LOCAL do processo (ver CLAUDE.md > Relatórios).
# Fixe o fuso em TODOS os ambientes, ou local e produção divergem de dia.
TZ=America/Sao_Paulo

# Origens autorizadas a chamar a API (lista separada por vírgula).
# Vazio = libera qualquer origem — aceitável só no localhost.
# Em produção: a URL do frontend na Vercel, ex.:
# CORS_ORIGIN=https://prumo.vercel.app,https://www.seudominio.com.br
CORS_ORIGIN=http://localhost:3001

# --- Postgres ---
# DATABASE_URL: usada pelo Prisma Client em runtime
# DIRECT_URL:   usada pelo `prisma migrate` (precisa de conexão direta, sem pooler)
#
# DEV (padrão): Postgres local em Docker — `docker compose up -d` na raiz do repo.
# Não há pooler local, então as duas URLs apontam para a mesma porta.
DATABASE_URL="postgresql://ordenai:ordenai_dev@localhost:5432/ordenai?schema=public"
DIRECT_URL="postgresql://ordenai:ordenai_dev@localhost:5432/ordenai?schema=public"

# PRODUÇÃO / Neon: Dashboard do projeto > Connect. Ver DEPLOY.md.
# O Neon mostra UMA string por vez; o toggle "Connection pooling" alterna entre
# os dois hosts do mesmo banco:
#   - ligado   → host com `-pooler` (PgBouncer), para o runtime
#   - desligado→ host sem `-pooler` (conexão direta), exigido pelo `prisma migrate`
# Ao copiar: REMOVA `channel_binding=require` (o driver do Prisma não entende) e
# mantenha `sslmode=require` — o Neon só aceita TLS.
# DATABASE_URL="postgresql://<user>:<senha>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://<user>:<senha>@ep-xxx.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Auth (JWT próprio, HS256) ---
# Segredo de assinatura dos tokens. Gere um valor aleatório longo:
#   openssl rand -base64 48
# Trocar este valor invalida todas as sessões ativas. NUNCA reutilize o segredo
# de desenvolvimento em produção.
JWT_SECRET="<gere-um-segredo-aleatorio-longo>"
# Validade do token de acesso (vai em todo request) e do de refresh.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
