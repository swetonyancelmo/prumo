// Prumo — schema do banco (Fase 1)
// Modelo de dados conforme CLAUDE.md > "Modelo de dados".
// Valores monetários usam Decimal(12,2) para precisão financeira.

generator client {
  provider = "prisma-client-js"
}

// Uma única URL, e ela precisa ser a conexão DIRETA do Neon (host sem
// `-pooler`). O `prisma migrate` não funciona de forma confiável através do
// PgBouncer em modo transação — usa advisory locks, que dependem de sessão
// persistente. Como a API roda numa instância só e abre poucas conexões, o
// pooler não faz falta; ter as duas URLs era complexidade sem contrapartida.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Enums
// --------------------------------------------------------------------------

enum CategoryType {
  despesa
  receita
}

// Colunas fixas do quadro Kanban de tarefas.
enum TaskStatus {
  backlog
  todo
  doing
  done
}

// --------------------------------------------------------------------------
// Modelos
// --------------------------------------------------------------------------

// A conta é do próprio Prumo: `id` é gerado aqui (não vem mais de um provedor
// externo) e `email` + `passwordHash` são a credencial de login.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")

  categories Category[]
  expenses   Expense[]
  incomes    Income[]
  tasks      Task[]
  notes      Note[]

  @@map("users")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  name      String
  type      CategoryType
  isDefault Boolean      @default(false) @map("is_default")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Expense {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  amount      Decimal     @db.Decimal(12, 2)
  categoryId  String?     @map("category_id") @db.Uuid
  description String?
  occurredAt  DateTime    @map("occurred_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([categoryId])
  @@map("expenses")
}

model Income {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  amount      Decimal     @db.Decimal(12, 2)
  description String?
  receivedAt  DateTime    @map("received_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@map("incomes")
}

model Task {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  title          String
  description    String?
  dueDate        DateTime?   @map("due_date")
  // Quando true, a hora em dueDate é significativa (compromisso/agenda).
  // Quando false, dueDate representa o dia inteiro (tarefa sem horário).
  hasTime        Boolean     @default(false) @map("has_time")
  isRecurring    Boolean     @default(false) @map("is_recurring")
  recurrenceRule String?     @map("recurrence_rule")
  status         TaskStatus  @default(todo)
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, status])
  @@map("tasks")
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?  @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("notes")
}
